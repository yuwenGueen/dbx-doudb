{
  "$schema": "https://raw.githubusercontent.com/t8y2/dbx/main/plugins/manifest.schema.json",
  "manifest_version": 1,
  "id": "dev.doudb.suite",
  "name": "DouDB",
  "version": "0.1.4",
  "publisher": "doudb",
  "description": "数据库主题的斗地主，支持三人、四人和电脑补位。",
  "icon": "assets/plugin.svg",
  "engines": {
    "dbx": ">=0.6.0",
    "host_api": "1"
  },
  "permissions": [],
  "entrypoints": {
    "ui": {
      "root": "ui",
      "entry": "ui/index.html"
    },
    "backend": {
      "executable": "bin/doudb"
    }
  },
  "contributions": [
    {
      "type": "workbench",
      "id": "dev.doudb.suite.lobby",
      "label": "DouDB",
      "icon": "assets/plugin.svg"
    }
  ]
}
